# === Telegram ===
BOT_TOKEN=

# id администраторов через запятую, кому падают уведомления о тикетах/платежах
# и кто может вызывать /stats. Пример ниже уже включает указанный тобой ID.
ADMIN_IDS=1489999225

# username бота без @, нужен для генерации реферальных ссылок
BOT_USERNAME=MyAiVPNbot

# === Канал для бесплатного часа ===
CHANNEL_ID=@MyAiVPN
CHANNEL_URL=https://t.me/MyAiVPN

# === База данных ===
DATABASE_PATH=bot.db

# === CryptoBot (Crypto Pay API) ===
CRYPTOBOT_API_TOKEN=

# === ЮKassa (карты + СБП) ===
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# === СБП напрямую через Сбер Эквайринг (опционально, если не через ЮKassa) ===
SBERPAY_TERMINAL_KEY=
SBERPAY_SECRET_KEY=

# === Реферальная программа ===
REFERRAL_BONUS_RUB=50
REFERRAL_BONUS_TICKETS=2
REFERRAL_MUTUAL_TICKETS=1

# === Веб-админка ===
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SECRET_KEY=
# часть URL вместо /admin — держи в секрете, напр. panel-9f3a1c
ADMIN_URL_PATH=admin
ADMIN_HOST=0.0.0.0
ADMIN_PORT=8000

# === Sub-хаб (агрегированная ссылка подписки) ===
# домен/IP, на котором будет доступен /sub/<token> — то, что вставляют в Happ/V2Box
SUB_HUB_BASE_URL=http://localhost:8000

# === Первый сервер 3X-UI (сидируется в БД автоматически при первом старте) ===
XUI_API_URL=
XUI_USERNAME=
XUI_PASSWORD=
XUI_INBOUND_ID=1
XUI_CONNECT_HOST=
XUI_CONNECT_PORT=443
XUI_PUBLIC_KEY=
XUI_SHORT_ID=
XUI_SNI=
XUI_SERVER_LABEL=🇩🇪 Germany Premium
